@model GrillMaster.Models.MenuItem

@{
    ViewData["Title"] = "Edit Menu Item";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/admin-menu.css"
          asp-append-version="true" />
}

<div class="admin-menu-page">
    <div class="admin-menu-container">
        <div class="admin-menu-header">
            <div>
                <div class="admin-menu-label">GRILLMASTER ADMIN</div>
                <h1>Edit Menu Item</h1>
                <p>Update the information of this menu item.</p>
            </div>

            <a asp-action="Index"
               class="admin-secondary-btn">
                ← Back to Menu
            </a>
        </div>

        <div class="admin-form-card">
            <div class="admin-form-header">
                <div class="form-item-icon">🍔</div>
                <div>
                    <h3>Edit Item</h3>
                    <p>Item #@Model.Id</p>
                </div>
            </div>

            <form asp-action="Edit"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="login-validation"></div>

                <div class="admin-form-group">
                    <label asp-for="Name">Item Name</label>
                    <input asp-for="Name"
                           placeholder="Enter item name"
                           autocomplete="off" />
                    <span asp-validation-for="Name"
                          class="form-error"></span>
                </div>

                <div class="admin-form-group">
                    <label asp-for="Description">Description</label>
                    <textarea asp-for="Description"
                              rows="4"
                              placeholder="Enter item description"></textarea>
                    <span asp-validation-for="Description"
                          class="form-error"></span>
                </div>

                <div class="admin-form-group">
                    <label asp-for="Price">Price</label>
                    <div class="price-input-wrapper">
                        <input asp-for="Price"
                               type="number"
                               step="0.01"
                               min="0"
                               placeholder="0.00" />
                        <span>EGP</span>
                    </div>
                    <span asp-validation-for="Price"
                          class="form-error"></span>
                </div>

                <div class="admin-form-group">
                    <label for="imageFile">Menu Image</label>

                    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                    {
                        <div class="current-image-preview">
                            <img src="@Model.ImageUrl"
                                 alt="@Model.Name"
                                 loading="lazy" />
                            <div>
                                <strong>Current image</strong>
                                <label class="remove-image-option">
                                    <input type="checkbox"
                                           name="removeImage"
                                           value="true" />
                                    Remove current image
                                </label>
                            </div>
                        </div>
                    }

                    <input id="imageFile"
                           name="imageFile"
                           type="file"
                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />

                    <small class="admin-help-text">
                        Upload a replacement image, or leave empty to keep the current image.
                        JPG, JPEG, PNG, or WEBP. Maximum size: 5 MB.
                    </small>

                    <span asp-validation-for="ImageUrl"
                          class="form-error"></span>
                </div>

                <div class="admin-form-group">
                    <label asp-for="CategoryId">Category</label>
                    <select asp-for="CategoryId">
                        <option value="">-- Select Category --</option>
                        @foreach (var category in ViewBag.Categories)
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    </select>
                    <span asp-validation-for="CategoryId"
                          class="form-error"></span>
                </div>

                <div class="admin-form-actions">
                    <button type="submit" class="save-item-btn">
                        Save Changes
                    </button>

                    <a asp-action="Index"
                       class="admin-secondary-btn">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
