# Build stage
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build

WORKDIR /src

COPY ["GrillMaster.csproj", "./"]

RUN dotnet restore "GrillMaster.csproj"

COPY . .

RUN dotnet publish "GrillMaster.csproj" \
    -c Release \
    -o /app/publish \
    --no-restore

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final

WORKDIR /app

COPY --from=build /app/publish .

ENV ASPNETCORE_URLS=http://0.0.0.0:${PORT:-80}

ENTRYPOINT ["dotnet", "GrillMaster.dll"]
