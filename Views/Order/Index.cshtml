@model GrillMaster.Models.OrderFormViewModel

@{
    ViewData["Title"] = "Your Order";

    var selectedMenuItems =
        ViewBag.SelectedMenuItems as List<GrillMaster.Models.MenuItem>
        ?? new List<GrillMaster.Models.MenuItem>();

    var selectedQuantities =
        ViewBag.SelectedQuantities as Dictionary<int, int>
        ?? new Dictionary<int, int>();

    decimal subtotal = 0;
    int totalItems = 0;

    var imageMap = new Dictionary<string, string>
            {
                ["Grilled Chicken"] = "/images/5873160425308884073.jpg",
                ["Beef Skewers"] = "/images/5873160425308884069.jpg",
                ["Double Burger"] = "/images/5873160425308884068.jpg",
                ["Mixed Grill Platter"] = "/images/5873160425308884070.jpg",
                ["Pizza"] = "/images/5873160425308884072.jpg",
                ["Meatball Pasta"] = "/images/5873160425308884071.jpg"
            };

    foreach (var item in selectedMenuItems)
    {
        var quantity = selectedQuantities.ContainsKey(item.Id)
            ? selectedQuantities[item.Id]
            : 1;

        if (quantity < 1)
        {
            quantity = 1;
        }

        subtotal += item.Price * quantity;
        totalItems += quantity;
    }
}

<div class="order-page">

    <!-- HEADER -->
    <section class="order-header">

        <span class="order-eyebrow">GRILLMASTER</span>

        <h1>
            REVIEW
            <span>YOUR ORDER</span>
        </h1>

        <p>
            Check your selected meals, quantities, and total before confirming.
        </p>

    </section>


    <form asp-controller="Order"
          asp-action="Index"
          method="post"
          class="checkout-form">

        @Html.AntiForgeryToken()


        <!-- SELECTED ITEMS -->
        <section class="order-section">

            <div class="section-heading">

                <div class="section-title">
                    <span>01</span>
                    <h2>Selected Items</h2>
                </div>

                <a asp-controller="Menu"
                   asp-action="Index"
                   class="back-menu-btn">
                    ← Back to Menu
                </a>

            </div>


            @if (!selectedMenuItems.Any())
            {
                <div class="empty-order">

                    <div class="empty-order-icon">
                        +
                    </div>

                    <h3>Your order is empty</h3>

                    <p>
                        Go back to the menu and select the meals you want.
                    </p>

                    <a asp-controller="Menu"
                       asp-action="Index"
                       class="empty-order-btn">
                        Browse Menu
                    </a>

                </div>
            }
            else
            {
                <div class="order-items">

                    @foreach (var item in selectedMenuItems)
                    {
                        var quantity = selectedQuantities.ContainsKey(item.Id)
                        ? selectedQuantities[item.Id]
                        : 1;

                        if (quantity < 1)
                        {
                            quantity = 1;
                        }

                        var itemTotal = item.Price * quantity;

                        var imageUrl = !string.IsNullOrWhiteSpace(item.ImageUrl)
                        ? item.ImageUrl
                        : imageMap.GetValueOrDefault(item.Name);

                        <div class="order-item"
                             data-item-id="@item.Id"
                             data-price="@item.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)">

                            <!-- IMAGE -->
                            <div class="order-item-image">

                                @if (!string.IsNullOrWhiteSpace(imageUrl))
                                {
                                    <img src="@imageUrl"
                                         alt="@item.Name"
                                         loading="lazy"
                                         onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                                    <div class="order-no-image" style="display:none;">
                                        GM
                                    </div>
                                }
                                else
                                {
                                    <div class="order-no-image">
                                        GM
                                    </div>
                                }

                            </div>


                            <!-- DETAILS -->
                            <div class="order-item-details">

                                <h3>
                                    @item.Name
                                </h3>

                                @if (!string.IsNullOrWhiteSpace(item.Description))
                                {
                                    <p>
                                        @item.Description
                                    </p>
                                }

                                <div class="item-meta">

                                    <span class="unit-price">
                                        @item.Price.ToString("0.00") EGP each
                                    </span>

                                </div>


                                <!-- QUANTITY CONTROLS -->
                                <div class="order-controls">

                                    <button type="button"
                                            class="quantity-btn decrease-btn"
                                            data-item-id="@item.Id"
                                            aria-label="Decrease quantity">
                                        −
                                    </button>

                                    <span class="quantity-value"
                                          data-quantity="@item.Id">
                                        @quantity
                                    </span>

                                    <button type="button"
                                            class="quantity-btn increase-btn"
                                            data-item-id="@item.Id"
                                            aria-label="Increase quantity">
                                        +
                                    </button>

                                    <button type="button"
                                            class="remove-order-btn"
                                            data-item-id="@item.Id">
                                        Remove
                                    </button>

                                </div>

                            </div>


                            <!-- PRICE -->
                            <div class="order-item-price">

                                <span>Total</span>

                                <strong data-item-total="@item.Id">
                                    @itemTotal.ToString("0.00")
                                    <small>EGP</small>
                                </strong>

                            </div>


                            <!-- FORM DATA -->
                            <input type="hidden"
                                   name="meals"
                                   value="@item.Name" />

                            <input type="hidden"
                                   name="quantities[@item.Name]"
                                   value="@quantity"
                                   data-quantity-input="@item.Id" />

                        </div>
                    }

                </div>
            }

        </section>


        @if (selectedMenuItems.Any())
        {
            <!-- CUSTOMER INFORMATION -->
            <section class="order-section customer-section">

                <div class="section-heading">

                    <div class="section-title">
                        <span>02</span>
                        <h2>Customer Information</h2>
                    </div>

                </div>


                <div class="customer-grid">

                    <!-- NAME -->
                    <div class="form-group">

                        <label asp-for="fullname">
                            Full Name
                        </label>

                        <input asp-for="fullname"
                               class="order-input"
                               placeholder="Enter your full name"
                               autocomplete="name" />

                        <span asp-validation-for="fullname"
                              class="validation-message">
                        </span>

                    </div>


                    <!-- PHONE -->
                    <div class="form-group">

                        <label asp-for="phone">
                            Phone Number
                        </label>

                        <input asp-for="phone"
                               class="order-input"
                               placeholder="01XXXXXXXXX"
                               inputmode="numeric"
                               autocomplete="tel" />

                        <span asp-validation-for="phone"
                              class="validation-message">
                        </span>

                    </div>


                    <!-- ADDRESS -->
                    <div class="form-group full-width">

                        <label asp-for="address">
                            Delivery Address
                        </label>

                        <textarea asp-for="address"
                                  class="order-input order-textarea"
                                  placeholder="Enter your complete delivery address"
                                  rows="4"
                                  autocomplete="street-address"></textarea>

                        <span asp-validation-for="address"
                              class="validation-message">
                        </span>

                    </div>

                </div>

            </section>


            <!-- SUMMARY -->
            <section class="order-summary-section">

                <div class="summary-card">

                    <div class="summary-title">

                        <div class="summary-number">
                            03
                        </div>

                        <h2>Order Summary</h2>

                    </div>


                    <div class="summary-line">

                        <span>Items</span>

                        <strong id="summary-items">
                            @totalItems
                        </strong>

                    </div>


                    <div class="summary-line">

                        <span>Subtotal</span>

                        <strong>
                            <span id="summary-subtotal">
                                @subtotal.ToString("0.00")
                            </span>
                            EGP
                        </strong>

                    </div>


                    <div class="summary-line">

                        <span>Delivery</span>

                        <strong class="free-delivery">
                            FREE
                        </strong>

                    </div>


                    <div class="summary-divider"></div>


                    <div class="summary-total">

                        <span>Total</span>

                        <strong>

                            <span id="summary-total">
                                @subtotal.ToString("0.00")
                            </span>

                            <small>EGP</small>

                        </strong>

                    </div>


                    <button type="submit"
                            class="confirm-order-btn">

                        <span>
                            Confirm Order
                        </span>

                        <strong>
                            →
                        </strong>

                    </button>


                    <p class="secure-note">
                        Your order will be sent to GrillMaster for confirmation.
                    </p>

                </div>

            </section>
        }

    </form>

</div>


