@using GrillMaster.Models
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Grill Master</title>

    <link rel="icon"
          type="image/png"
          href="~/images/5868311149533662127.png" />

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Shared Navbar CSS -->
    <link rel="stylesheet"
          href="~/css/navbar.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)

</head>


<body>

    <!-- ================= NAVBAR ================= -->

    <nav class="navbar custom-nav">

        <!-- LOGO -->
        <div class="nav-left">

            <a asp-controller="Home"
               asp-action="Index"
               class="nav-logo-link">

                <img src="~/images/5868311149533662127.png"
                     alt="Restaurant Logo"
                     class="nav-logo" />

            </a>

        </div>


        <!-- BRAND -->
        <div class="nav-center">

            <a asp-controller="Home"
               asp-action="Index"
               class="restaurant-name-link">

                <h1 class="restaurant-name">
                    Grill Master
                </h1>

            </a>

        </div>


        <!-- MOBILE MENU BUTTON -->
        <button class="mobile-menu-toggle"
                type="button"
                aria-label="Toggle navigation"
                aria-expanded="false">

            <span></span>
            <span></span>
            <span></span>

        </button>


        <!-- NAVIGATION + ACCOUNT -->
        <div class="nav-right">

            <div class="nav-links">

                <a asp-controller="Home"
                   asp-action="Index">
                    Home
                </a>

                <a asp-controller="Menu"
                   asp-action="Index">
                    Menu
                </a>

                <a asp-controller="Order"
                   asp-action="ViewOrder">
                    Order
                </a>

                <a asp-controller="Branches"
                   asp-action="Index">
                    Branches
                </a>

                <a asp-controller="About"
                   asp-action="Index">
                    About
                </a>

            </div>


            @if (User.Identity?.IsAuthenticated == true)
            {
                var currentUser =
                await UserManager.GetUserAsync(User);

                <div class="nav-account">

                    <!-- USER INFO -->
                    <div class="user-info">

                        <span class="user-icon">
                            👤
                        </span>

                        <div class="user-details">

                            <span class="user-label">
                                Logged in as
                            </span>

                            <span class="user-name">
                                @(currentUser?.FullName ?? "User")
                            </span>

                        </div>

                    </div>


                    <!-- ADMIN -->
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="AdminDashboard"
                           asp-action="Index"
                           class="admin-nav-link">

                            Admin Panel

                        </a>
                    }


                    <!-- MY ORDERS -->
                    <a asp-controller="Order"
                       asp-action="MyOrders"
                       class="my-orders-nav-link">

                        My Orders

                    </a>


                    <!-- LOGOUT -->
                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post"
                          class="logout-form">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="logout-nav-btn">

                            Logout

                        </button>

                    </form>

                </div>
            }
            else
            {
                <div class="guest-auth-links">

                    <a asp-controller="Account"
                       asp-action="Login"
                       class="login-nav-link">

                        Login

                    </a>

                    <a asp-controller="Account"
                       asp-action="Register"
                       class="register-nav-link">

                        Register

                    </a>

                </div>
            }

        </div>

    </nav>


    <!-- ================= PAGE CONTENT ================= -->

    <main>

        @RenderBody()

    </main>


    <!-- ================= FOOTER ================= -->

    <footer class="footer">

        <div class="footer-content">

            <div class="footer-left">

                <div class="footer-brand">
                    Grill Master
                </div>

                <div class="footer-tagline">
                    Real fire, bold flavor, unforgettable moments.
                </div>

            </div>


            <div class="footer-links">

                <a asp-controller="Home"
                   asp-action="Index">
                    Home
                </a>

                <a asp-controller="Menu"
                   asp-action="Index">
                    Menu
                </a>

                <a asp-controller="Order"
                   asp-action="ViewOrder">
                    Order
                </a>

                <a asp-controller="Branches"
                   asp-action="Index">
                    Branches
                </a>

                <a asp-controller="About"
                   asp-action="Index">
                    About/Contact
                </a>

            </div>

        </div>


        <div class="footer-bottom">

            © 2026 Grill Master. All rights reserved.

        </div>

    </footer>


    <!-- Bootstrap -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>


    <!-- Mobile Navbar -->
    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const toggle =
                document.querySelector(".mobile-menu-toggle");

            const nav =
                document.querySelector(".nav-right");

            if (!toggle || !nav) {
                return;
            }

            toggle.addEventListener("click", function () {

                const isOpen =
                    nav.classList.toggle("mobile-open");

                toggle.classList.toggle(
                    "active",
                    isOpen
                );

                toggle.setAttribute(
                    "aria-expanded",
                    isOpen.toString()
                );

            });


            // Close mobile menu after clicking a navigation link.
            nav.querySelectorAll("a").forEach(function (link) {

                link.addEventListener("click", function () {

                    nav.classList.remove("mobile-open");

                    toggle.classList.remove("active");

                    toggle.setAttribute(
                        "aria-expanded",
                        "false"
                    );

                });

            });

        });

    </script>


    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>