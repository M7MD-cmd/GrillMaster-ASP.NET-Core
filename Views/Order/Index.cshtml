    </style>
}


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const checkoutForm = document.querySelector(".checkout-form");

            if (!checkoutForm) {
                return;
            }

            const tokenInput =
                checkoutForm.querySelector('input[name="__RequestVerificationToken"]');

            const token = tokenInput ? tokenInput.value : "";

            async function sendRequest(url, data) {

                const formData = new FormData();

                Object.keys(data).forEach(function (key) {
                    formData.append(key, data[key]);
                });

                formData.append("__RequestVerificationToken", token);

                const response = await fetch(url, {
                    method: "POST",
                    body: formData,
                    headers: {
                        "RequestVerificationToken": token
                    }
                });

                if (!response.ok) {
                    throw new Error("Request failed.");
                }

                return await response.json();
            }


            function updateSummary() {

                let totalItems = 0;
                let subtotal = 0;

                document.querySelectorAll(".order-item").forEach(function (item) {

                    const price =
                        parseFloat(item.dataset.price || "0");

                    const quantityElement =
                        item.querySelector(".quantity-value");

                    if (!quantityElement) {
                        return;
                    }

                    const quantity =
                        parseInt(quantityElement.textContent || "1");

                    totalItems += quantity;
                    subtotal += price * quantity;

                });


                const itemsElement =
                    document.getElementById("summary-items");

                const subtotalElement =
                    document.getElementById("summary-subtotal");

                const totalElement =
                    document.getElementById("summary-total");


                if (itemsElement) {
                    itemsElement.textContent = totalItems;
                }

                if (subtotalElement) {
                    subtotalElement.textContent =
                        subtotal.toFixed(2);
                }

                if (totalElement) {
                    totalElement.textContent =
                        subtotal.toFixed(2);
                }

            }


            function updateItemUI(item, quantity) {

                const itemId = item.dataset.itemId;

                const quantityElement =
                    item.querySelector(".quantity-value");

                const quantityInput =
                    item.querySelector(
                        `[data-quantity-input="${itemId}"]`
                    );

                const itemTotalElement =
                    item.querySelector(
                        `[data-item-total="${itemId}"]`
                    );

                const price =
                    parseFloat(item.dataset.price || "0");


                if (quantityElement) {
                    quantityElement.textContent = quantity;
                }

                if (quantityInput) {
                    quantityInput.value = quantity;
                }

                if (itemTotalElement) {

                    itemTotalElement.innerHTML =
                        `${(price * quantity).toFixed(2)} <small>EGP</small>`;

                }

                updateSummary();

            }


            async function changeQuantity(itemId, quantity) {

                if (quantity < 1) {
                    quantity = 1;
                }

                const item =
                    document.querySelector(
                        `.order-item[data-item-id="${itemId}"]`
                    );

                if (!item) {
                    return;
                }

                item.classList.add("is-loading");

                try {

                    const result = await sendRequest(
                        "@Url.Action("UpdateQuantity", "Order")",
                        {
                            menuItemId: itemId,
                            quantity: quantity
                        }
                    );


                    if (!result.success) {
                        throw new Error(
                            result.message || "Unable to update quantity."
                        );
                    }

                    updateItemUI(item, result.quantity);

                }
                catch (error) {

                    console.error(error);

                    alert(
                        "Unable to update the item. Please try again."
                    );

                }
                finally {

                    item.classList.remove("is-loading");

                }

            }


            async function removeItem(itemId) {

                const item =
                    document.querySelector(
                        `.order-item[data-item-id="${itemId}"]`
                    );

                if (!item) {
                    return;
                }


                item.classList.add("is-loading");

                try {

                    const result = await sendRequest(
                        "@Url.Action("RemoveFromOrder", "Order")",
                        {
                            menuItemId: itemId
                        }
                    );


                    if (!result.success) {
                        throw new Error(
                            result.message || "Unable to remove item."
                        );
                    }


                    item.remove();

                    updateSummary();


                    if (result.totalCount <= 0) {
                        window.location.href =
                            "@Url.Action("Index", "Order")";
                    }

                }
                catch (error) {

                    console.error(error);

                    item.classList.remove("is-loading");

                    alert(
                        "Unable to remove the item. Please try again."
                    );

                }

            }


            document.querySelectorAll(".increase-btn")
                .forEach(function (button) {

                    button.addEventListener("click", function () {

                        const itemId =
                            this.dataset.itemId;

                        const item =
                            document.querySelector(
                                `.order-item[data-item-id="${itemId}"]`
                            );

                        if (!item) {
                            return;
                        }

                        const currentQuantity =
                            parseInt(
                                item.querySelector(".quantity-value")
                                    .textContent
                            ) || 1;

                        changeQuantity(
                            itemId,
                            currentQuantity + 1
                        );

                    });

                });


            document.querySelectorAll(".decrease-btn")
                .forEach(function (button) {

                    button.addEventListener("click", function () {

                        const itemId =
                            this.dataset.itemId;

                        const item =
                            document.querySelector(
                                `.order-item[data-item-id="${itemId}"]`
                            );

                        if (!item) {
                            return;
                        }

                        const currentQuantity =
                            parseInt(
                                item.querySelector(".quantity-value")
                                    .textContent
                            ) || 1;

                        if (currentQuantity <= 1) {
                            return;
                        }

                        changeQuantity(
                            itemId,
                            currentQuantity - 1
                        );

                    });

                });


            document.querySelectorAll(".remove-order-btn")
                .forEach(function (button) {

                    button.addEventListener("click", function () {

                        const itemId =
                            this.dataset.itemId;

                        removeItem(itemId);

                    });

                });

            // Prevent accidental double submission during checkout.
            checkoutForm.addEventListener("submit", function () {
                const submitButton =
                    checkoutForm.querySelector('button[type="submit"]');

                if (!submitButton) {
                    return;
                }

                submitButton.disabled = true;
                submitButton.classList.add("is-submitting");

                const label = submitButton.querySelector("span");

                if (label) {
                    label.textContent = "Processing...";
                }
            });

        });

    </script>
}