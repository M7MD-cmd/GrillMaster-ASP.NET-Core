@{
    ViewData["Title"] = "Home";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" />
}

<!-- HERO -->
<section class="hero">
    <h1 class="hero-title">
        <span class="word-yellow">Grill</span>
        <span class="word-white" style="color: white">Master</span>
    </h1>
    <div class="hero-taglines">
        <p class="tagline" id="line1">Real Fire, Real Flavor Since 1995</p>
        <p class="tagline" id="line2">Fresh Meat. Real Charcoal.</p>
    </div>
</section>

<!-- CAROUSEL -->
<div id="foodCarousel" class="carousel slide small-carousel" data-bs-ride="carousel" data-bs-interval="2500">
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img src="~/images/ChatGPT Image Nov 22, 2025, 12_54_59 AM.png" class="d-block w-100" alt="Food 1" />
        </div>
        <div class="carousel-item">
            <img src="~/images/ChatGPT Image Nov 22, 2025, 12_51_32 AM.png" class="d-block w-100" alt="Food 2" />
        </div>
        <div class="carousel-item">
            <img src="~/images/ChatGPT Image Nov 22, 2025, 12_50_50 AM.png" class="d-block w-100" alt="Food 3" />
        </div>
    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#foodCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#foodCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon"></span>
    </button>
</div>

<!-- IDENTITY -->
<section class="identity">
    <p>Born on real charcoal, serving authentic fire-kissed flavor since 1995.</p>
    <p>From a small family street grill to a global destination for meat lovers.</p>
</section>

<!-- CERTIFICATES / STANDARDS -->
<section class="cert-section">
    <div class="container">
        <h2 class="cert-section-title">Our Standards</h2>
        <p class="cert-section-subtitle">Committed to clean, safe, and high-quality food — every day.</p>

        <div class="row g-3">
            <div class="col-md-4">
                <div class="cert-card">
                    <div class="cert-icon">🧼</div>
                    <div class="cert-title">Hygienic Kitchen</div>
                    <div class="cert-text">Strict cleaning routines and sanitized surfaces to keep every corner spotless.</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="cert-card">
                    <div class="cert-icon">✅</div>
                    <div class="cert-title">Certified Quality</div>
                    <div class="cert-text">Meat and ingredients sourced from trusted, certified suppliers only.</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="cert-card">
                    <div class="cert-icon">🌿</div>
                    <div class="cert-title">Fresh Ingredients</div>
                    <div class="cert-text">Daily-prepared marinades and hand-picked ingredients for real flavor.</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- BUTTONS -->
<section class="home-buttons">
    <a asp-controller="Menu" asp-action="Index" class="home-btn">Our Menu</a>
    <a asp-controller="Order" asp-action="Index" class="home-btn">Order</a>
    <a asp-controller="Branches" asp-action="Index" class="home-btn">Branches</a>
    <a asp-controller="About" asp-action="Index" class="home-btn">About/Contact</a>
</section>

@section Scripts {
    <script>
        const texts = [
            "Real Fire, Real Flavor Since 1995",
            "Fresh Meat. Real Charcoal.",
            "Grilled With Passion ",
            "Authentic Taste Since 1995",
            "Born on Real Charcoal",
            "Fire-Kissed Perfection",
            "Savor the Smoke",
        ];

        let index = 2;
        const line1 = document.getElementById("line1");
        const line2 = document.getElementById("line2");

        setInterval(() => {
            line1.classList.add("slide-up");
            line2.classList.add("slide-down");

            setTimeout(() => {
                line2.textContent = line1.textContent;
                line1.textContent = texts[index % texts.length];
                index++;
                line1.classList.remove("slide-up");
                line2.classList.remove("slide-down");
            }, 600);
        }, 3000);
    </script>
}
